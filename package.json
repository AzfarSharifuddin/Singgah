{
  "name": "singgah",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:validate": "node scripts/database.mjs validate && node scripts/validate-seed.mjs",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:seed": "node scripts/database.mjs seed",
    "db:test": "node scripts/database.mjs test",
    "supabase:check": "node scripts/check-supabase.ts",
    "test:vendor-format": "node --test scripts/test-vendor-format.ts",
    "test:vendor-browser": "node scripts/test-vendor-browser.mjs",
    "test:discovery": "node --test scripts/test-discovery.ts",
    "test:discovery-browser": "node scripts/test-discovery-browser.mjs",
    "reviews:configure": "node scripts/configure-review-key.mjs",
    "test:reviews": "node --conditions=react-server --test scripts/test-review-validation.ts scripts/test-review-protection.ts",
    "test:reviews-db": "node scripts/test-review-database.mjs",
    "test:reviews-browser": "node scripts/test-review-browser.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.6",
    "pg": "^8.23.0",
    "pgsql-parser": "^18.2.8",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
