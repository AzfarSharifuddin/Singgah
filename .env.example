# Copy to ignored .env.local. Supply real values locally; never commit secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Database administration scripts only: approved Singgah Dev session-pooler URI.
# Percent-encode reserved characters in its password. Not needed by the web app.
SUPABASE_DB_URL=

# Must match private.review_submission_config; provision with npm run reviews:configure.
REVIEW_SUBMISSION_SECRET=

# Public widget site key; secret is server-side only. Auth CAPTCHA must match.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=singgah.cc,www.singgah.cc
# Official test keys for local next dev only. Production always requires real keys.
TURNSTILE_TEST_MODE=false

# Resend SMTP credentials belong in Supabase Auth SMTP settings, not this app.
