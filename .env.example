# Hosted Supabase development project. Copy to ignored .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Database scripts only: Singgah Dev session-pooler URI with database password.
SUPABASE_DB_URL=
# Never expose privileged credentials through NEXT_PUBLIC_ variables.

# Review protection. Configure the signing key with npm run reviews:configure.
REVIEW_SUBMISSION_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated exact hostnames (no scheme/port), e.g. singgah.my,www.singgah.my
TURNSTILE_ALLOWED_HOSTNAMES=
# Local next dev only. Uses official Cloudflare test keys; never works in production.
TURNSTILE_TEST_MODE=false
